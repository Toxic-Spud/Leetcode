class Solution:
    def next_setion (current, remaining, sections):
        length = len(remaining)
        if int(remaining[0]) > 2 or int(remaining[0:3]) > 255:
            maximum = min(min(3,length-(sections-1)),2)
        else:
            maximum = min(min(3,length-(sections-1)),3)
        minimum = max(1,length - (3*(sections-1)))
        if remaining[0] == "0":
            if minimum > 1:
                return ""
            return [(current + "0.", remaining[1:])]
        if minimum > maximum:
            return ""
        res = []
        for i in range(minimum, maximum + 1):
            res.append((current + remaining[:i] + ".", remaining[i:]))
        return res

    def restoreIpAddresses(self, s: str) -> list[str]:
        byte_count = 4
        prev = [("",s)]
        cur = []
        while byte_count > 0:
            for item in prev:
                if len(item[1]) < 1:
                    continue
                partial_solution = Solution.next_setion(item[0], item[1], byte_count)
                if partial_solution != "":
                    cur = cur + partial_solution
            prev = cur
            cur = []
            byte_count = byte_count - 1
        res = []
        for item in prev:
            res.append(item[0].strip("."))
        return res
