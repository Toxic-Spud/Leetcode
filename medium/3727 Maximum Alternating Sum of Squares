from bisect import insort

class Solution:
    def maxAlternatingSum(self, nums: List[int]) -> int:
        length = len(nums)
        negatives = length // 2
        for i in range(len(nums)): nums[i] = abs(nums[i])
        nums.sort()
        tot = 0
        i = 0
        while i < negatives:
            tot -= nums[i] ** 2
            tot += nums[length-1-i] ** 2
            i += 1
        if length % 2 != 0:
            tot += nums[negatives] ** 2
        return tot
        
        
        
        
