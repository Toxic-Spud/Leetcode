class Solution:
    def threeSumClosest(self, nums: List[int], target: int) -> int:
        closest = float("inf")
        nums.sort()
        for i, num in enumerate(nums[:-2]):
            p1 = i + 1
            p2 = len(nums) - 1
            while p1 < p2:
                triplet = num + nums[p1] + nums[p2]
                if abs(target - triplet) < abs(target - closest):
                    closest = triplet
                    if closest == target:
                        return closest
                if triplet > target:
                    p2 = p2 - 1
                else:
                    p1 = p1 + 1
        return closest
