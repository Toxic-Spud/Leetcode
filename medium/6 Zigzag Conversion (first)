class Solution:
    def convert(self, s: str, numRows: int) -> str:
        diag_chars = max(0,numRows - 2)
        dec_rows = max(0, numRows - 1)
        i = 0
        columns = [[]]
        diags = [[]]
        diag_chars_total = 0
        while (i < len(s)):
            current_column = len(columns) - 1
            columns[current_column].append(s[i])
            if ((i-diag_chars_total) % numRows) == (dec_rows):
                diag = s[i+1:i+1+diag_chars]
                diag_chars_total = diag_chars_total + diag_chars
                for iter, character in enumerate(diag):
                    column = [""] * numRows
                    column[numRows - iter - 2] = character
                    columns.append(column)
                columns.append([])
                i = i + diag_chars    
            i = i+1
        res = ""
        for i in range(len(columns[0])):
            for a in range(len(columns)):
                if i < len(columns[a]):
                    res = res + columns[a][i]
                elif a != len(columns) - 1:    
                    raise Exception("Something went wrong")

        return(res)
