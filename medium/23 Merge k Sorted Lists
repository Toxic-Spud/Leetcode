class Solution:
    def mergeKLists(self, lists: List[Optional[ListNode]]) -> Optional[ListNode]:
        if len(lists) < 1:
            return 
        if len(lists) == 1:
            return lists[0]
        if lists == ([None]* len(lists)):
            return lists[0]
        lowest = float("inf")
        lst_pos = 0

        for i, node in enumerate(lists):
            if node == None: continue
            if node.val < lowest:
                lowest = node.val
                sorting_node = node
                lst_pos = i
        lists[lst_pos] = lists[lst_pos].next
        start_node = sorting_node
        while lists != ([None] * len(lists)):
            lowest = float("inf")
            lst_pos = 0
            for i, node in enumerate(lists):
                if node == None: continue
                if node.val < lowest:
                    lowest = node.val
                    lst_pos = i
            selected_node = lists[lst_pos]
            lists[lst_pos] = selected_node.next
            sorting_node.next = selected_node
            sorting_node = selected_node
        return start_node
            
